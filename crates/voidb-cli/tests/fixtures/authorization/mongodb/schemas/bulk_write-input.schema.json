      "type": "string",
      "minLength": 1
    },
    "collection": {
      "type": "string",
      "minLength": 1
    },
    "ordered": {
      "type": "boolean",
      "default": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "insert",
              "update",
              "delete"
            ]
          },
          "document": {
            "type": "object",
            "additionalProperties": true
          },
          "filter": {
            "type": "object",
            "additionalProperties": true
          },
          "update": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
