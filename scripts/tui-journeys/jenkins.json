{
  "schema_version": 1,
  "name": "jenkins",
  "command": ["${VOIDB_CLI}", "jenkins", "tui", "--fixture", "crates/plugins/voidb-plugin-jenkins/fixtures/jenkins_tui_operations.json"],
  "rows": 30,
  "cols": 118,
  "timeout_ms": 12000,
  "measurement": {"cold_runs": 1, "warmup_runs": 1, "warm_runs": 3},
  "env": {"HOME": "${REPO_ROOT}/target/tmp/tui-journey-runtime/${RUN_ID}/home", "XDG_CONFIG_HOME": "${REPO_ROOT}/target/tmp/tui-journey-runtime/${RUN_ID}/home/.config", "VOIDB_JENKINS_AGENT_CONTEXT_DIR": "${REPO_ROOT}/target/tmp/tui-journey-runtime/${RUN_ID}/agent-context"},
  "prepare_dirs": ["${REPO_ROOT}/target/tmp/tui-journey-runtime/${RUN_ID}/home/.config"],
  "actions": [
    {"type": "wait", "name": "first_frame", "marker": "Jenkins Builds", "timeout_ms": 4000},
    {"type": "input", "name": "navigate", "data": "j", "marker": "job: worker", "metric": "key_to_repaint_ms", "timeout_ms": 500},
    {"type": "input", "name": "open_filter", "data": "/", "marker": "search: type text", "timeout_ms": 500},
    {"type": "input", "name": "filter_input", "data": "worker", "timeout_ms": 500},
    {"type": "input", "name": "apply_filter", "data_hex": "0d", "marker": "search applied: worker", "timeout_ms": 500},
    {"type": "input", "name": "open_help", "data": "?", "marker": "Jenkins build and console TUI", "timeout_ms": 500},
    {"type": "input", "name": "close_help", "data_hex": "1b", "marker": "returned to browser", "timeout_ms": 500},
    {"type": "input", "name": "open_builds", "data_hex": "0d", "marker": "fixture builds for worker", "timeout_ms": 500},
    {"type": "input", "name": "follow_console", "data": "f", "marker": "fixture console for worker #17", "timeout_ms": 500},
    {"type": "input", "name": "cancel_stream", "data": "c", "marker": "console follow stopped", "metric": "stream_cancel_ms", "timeout_ms": 1000},
    {"type": "resize", "name": "resize", "rows": 24, "cols": 96, "marker": "resized jenkins view", "metric": "resize_frame_ms", "timeout_ms": 500},
    {"type": "idle", "name": "idle", "duration_ms": 5000},
    {"type": "quit", "name": "quit", "data": "q", "metric": "quit_restore_ms", "timeout_ms": 1000}
  ],
  "required_markers": ["Jenkins Builds", "401 unauthorized fixture response", "Jenkins build and console TUI"],
  "forbidden_markers": ["super-secret-password", "token_value", "crumb_value"],
  "thresholds": {
    "warm": {
      "first_frame_ms": {"p50_ms": 500, "p95_ms": 750},
      "key_to_repaint_ms": {"p50_ms": 60, "p95_ms": 100},
      "stream_cancel_ms": {"p95_ms": 1000},
      "resize_frame_ms": {"p50_ms": 60, "p95_ms": 100},
      "quit_restore_ms": {"p50_ms": 150, "p95_ms": 250},
      "idle.cpu_percent": {"p95_max": 2},
      "idle.repaint_hz": {"p95_max": 2}
    }
  }
}
