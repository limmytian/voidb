{
  "schema_version": 1,
  "name": "connection-manager",
  "command": ["${VOIDB_TUI}", "--connection-manager"],
  "rows": 30,
  "cols": 100,
  "timeout_ms": 12000,
  "exit_timeout_ms": 1000,
  "measurement": {"cold_runs": 1, "warmup_runs": 1, "warm_runs": 3},
  "env": {
    "HOME": "${REPO_ROOT}/target/tmp/tui-journey-runtime/${RUN_ID}/home",
    "XDG_CONFIG_HOME": "${REPO_ROOT}/target/tmp/tui-journey-runtime/${RUN_ID}/home/.config"
  },
  "unset_env": ["VOIDB_MASTER_PASSWORD"],
  "prepare_dirs": ["${REPO_ROOT}/target/tmp/tui-journey-runtime/${RUN_ID}/home/.config"],
  "actions": [
    {"type": "wait", "name": "first_frame", "marker": "Native Connection Manager", "timeout_ms": 5000},
    {"type": "input", "name": "open_search", "data": "/", "marker": "Type to filter", "metric": "key_to_repaint_ms", "timeout_ms": 500},
    {"type": "input", "name": "search_input", "data": "fixture", "marker": "fixture", "timeout_ms": 500},
    {"type": "input", "name": "clear_search", "data_hex": "1b", "marker": "No native profiles yet", "timeout_ms": 500},
    {"type": "input", "name": "new_connection", "data": "n", "marker": "New native profile", "timeout_ms": 500},
    {"type": "input", "name": "close_dialog", "data_hex": "1b", "marker": "Native Connection Manager", "timeout_ms": 500},
    {"type": "input", "name": "open_help", "data": "?", "marker": "Help", "timeout_ms": 500},
    {"type": "input", "name": "close_help", "data_hex": "1b", "marker": "Native Connection Manager", "timeout_ms": 500},
    {"type": "resize", "name": "resize", "rows": 24, "cols": 80, "marker": "Native Connection Manager", "metric": "resize_frame_ms", "timeout_ms": 500},
    {"type": "idle", "name": "idle", "duration_ms": 5000},
    {"type": "quit", "name": "quit", "data_hex": "11", "metric": "quit_restore_ms", "timeout_ms": 1000}
  ],
  "required_markers": ["Native Connection Manager", "No native profiles yet", "New native profile"],
  "forbidden_markers": ["super-secret-password", "BEGIN OPENSSH PRIVATE KEY"],
  "thresholds": {
    "warm": {
      "first_frame_ms": {"p50_ms": 500, "p95_ms": 750},
      "key_to_repaint_ms": {"p50_ms": 60, "p95_ms": 100},
      "resize_frame_ms": {"p50_ms": 60, "p95_ms": 100},
      "quit_restore_ms": {"p50_ms": 150, "p95_ms": 250},
      "idle.cpu_percent": {"p95_max": 2},
      "idle.repaint_hz": {"p95_max": 2}
    }
  }
}
