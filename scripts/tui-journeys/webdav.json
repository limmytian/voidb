{
  "schema_version": 1,
  "name": "webdav",
  "command": ["${VOIDB_CLI}", "webdav", "tui", "--fixture", "crates/plugins/voidb-plugin-webdav/fixtures/webdav_tui_browser.json"],
  "rows": 30,
  "cols": 110,
  "timeout_ms": 12000,
  "measurement": {"cold_runs": 1, "warmup_runs": 1, "warm_runs": 3},
  "env": {"HOME": "${REPO_ROOT}/target/tmp/tui-journey-runtime/${RUN_ID}/home", "XDG_CONFIG_HOME": "${REPO_ROOT}/target/tmp/tui-journey-runtime/${RUN_ID}/home/.config"},
  "prepare_dirs": ["${REPO_ROOT}/target/tmp/tui-journey-runtime/${RUN_ID}/home/.config"],
  "actions": [
    {"type": "wait", "name": "first_frame", "marker": "WebDAV TUI", "timeout_ms": 4000},
    {"type": "input", "name": "navigate", "data": "j", "marker": "Kind: file", "metric": "key_to_repaint_ms", "timeout_ms": 500},
    {"type": "input", "name": "open_filter", "data": "/", "marker": "filter: type text", "timeout_ms": 500},
    {"type": "input", "name": "filter_input", "data": "report.csv", "marker": "report.csv", "timeout_ms": 500},
    {"type": "input", "name": "apply_filter", "data_hex": "0d", "marker": "filter applied", "timeout_ms": 500},
    {"type": "input", "name": "plan_download", "data": "d", "marker": "Plan: download", "timeout_ms": 500},
    {"type": "input", "name": "cancel_plan", "data": "c", "marker": "plan cancelled", "timeout_ms": 500},
    {"type": "input", "name": "open_help", "data": "?", "marker": "Directories are loaded", "timeout_ms": 500},
    {"type": "input", "name": "close_help", "data_hex": "1b", "marker": "returned to browser", "timeout_ms": 500},
    {"type": "resize", "name": "resize", "rows": 24, "cols": 90, "marker": "resized view", "metric": "resize_frame_ms", "timeout_ms": 500},
    {"type": "idle", "name": "idle", "duration_ms": 5000},
    {"type": "quit", "name": "quit", "data": "q", "metric": "quit_restore_ms", "timeout_ms": 1000}
  ],
  "required_markers": ["WebDAV TUI", "webdav.forbidden", "Directories are loaded"],
  "forbidden_markers": ["super-secret-password", "password_value", "token_value"],
  "thresholds": {
    "warm": {
      "first_frame_ms": {"p50_ms": 500, "p95_ms": 750},
      "key_to_repaint_ms": {"p50_ms": 60, "p95_ms": 100},
      "resize_frame_ms": {"p50_ms": 60, "p95_ms": 100},
      "quit_restore_ms": {"p50_ms": 150, "p95_ms": 250},
      "idle.cpu_percent": {"p95_max": 2},
      "idle.repaint_hz": {"p95_max": 2}
    }
  }
}
